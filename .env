# Database Configuration (CockroachDB)
DB_HOST=cockroachdb
DB_PORT=26257
DB_NAME=cleanarch_db
DB_USER=root
DB_PASSWORD=
DB_ADMIN_UI_PORT=8080

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=elastic123
ELASTICSEARCH_LOGSTASH_PORT=5000
KIBANA_PORT=5601

# JWT Configuration
JWT_SECRET=your-super-secret-256-bit-jwt-key-change-in-production-please-make-it-long-enough
JWT_EXPIRATION=86400000

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=DEBUG
LOG_FILE_PATH=logs
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_MAX_HISTORY=30

# Database Pool Configuration
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Redis Pool Configuration
REDIS_TIMEOUT=2000
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0

# Application Ports
SERVICE_API_PORT=8081

# Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# Java Configuration
JAVA_OPTS=-Xms512m -Xmx1024m
